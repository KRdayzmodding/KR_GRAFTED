build/
out/
.cache
.vs
RESEARCH/bin/
RESEARCH/out/
.vscode/*
# ...кроме общих конфигураций: задачи сборки и запуск отладчика одинаковы у всех,
# личного в них нет — каталог игры спрашивается при запуске.
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/dev-shell.cmd
.claude
examples/players/src/graft/
CMakeUserPresets.json
# объявления печатает сборка рядом с DLL — в исходниках их нет
grafted_natives_*.c
# ...кроме примеров: там сборка печатает их ПРЯМО В МОД (SCRIPTS_DIR), и лежать они
# обязаны в репозитории — пример должен показывать мод целиком, включая тот скриптовый
# код, который написан не рукой. Из клона шаблона (graft new) их убирает сам инструмент.
!examples/*/mod/*/scripts/*/grafted_natives_*.c
