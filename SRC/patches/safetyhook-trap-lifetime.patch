+// ── GRAFT: заплатка, см. SRC/patches/README.md ───────────────────────────────
+// Апстримный обработчик ниже отвечает «продолжай» по признаку «страница КОГДА-ТО была
+// нашей»: список отравленных страниц не чистится никогда, и настоящий сбой на такой
+// странице после снятия врезки уходит в вечный повтор вместо падения с дампом. Кадровый
+// обработчик приложения до него при этом не доходит.
+//
+// Признак заменён на проверяемый. Пока окно патча открыто — поведение ровно апстримное.
+// Закрылось — «продолжай» только если повтор обращения и правда пройдёт.
+//
+// Вторая половина обязательна из-за поздней доставки: поток может получить сбой внутри
+// окна, а до обработчика доехать уже после его закрытия. Права к тому времени вернули, и
+// ему нужен именно повтор, а не падение.
+std::atomic<int> graft_open_windows{0};
+
+struct GraftOpenWindow {
+    GraftOpenWindow() { graft_open_windows.fetch_add(1, std::memory_order_acq_rel); }
+    ~GraftOpenWindow() { graft_open_windows.fetch_sub(1, std::memory_order_acq_rel); }
+    GraftOpenWindow(const GraftOpenWindow&) = delete;
+    GraftOpenWindow& operator=(const GraftOpenWindow&) = delete;
+};
+
+inline LONG graft_resume_if_sensible(PEXCEPTION_POINTERS exp, uint8_t* at) {
+    if (graft_open_windows.load(std::memory_order_acquire) > 0) {
+        return EXCEPTION_CONTINUE_EXECUTION;
+    }
+    MEMORY_BASIC_INFORMATION mbi{};
+    if (VirtualQuery(at, &mbi, sizeof(mbi)) == 0 || mbi.State != MEM_COMMIT ||
+        (mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD)) != 0) {
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+    const DWORD p = mbi.Protect;
+    const ULONG_PTR kind = exp->ExceptionRecord->NumberParameters >= 1
+                               ? exp->ExceptionRecord->ExceptionInformation[0]
+                               : 0;
+    bool ok = false;
+    if (kind == 8) {
+        ok = (p & (PAGE_EXECUTE | PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY)) != 0;
+    } else if (kind == 1) {
+        ok = (p & (PAGE_READWRITE | PAGE_WRITECOPY | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY)) != 0;
+    } else {
+        ok = (p & (PAGE_READONLY | PAGE_READWRITE | PAGE_WRITECOPY | PAGE_EXECUTE_READ |
+                   PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY)) != 0;
+    }
+    return ok ? EXCEPTION_CONTINUE_EXECUTION : EXCEPTION_CONTINUE_SEARCH;
+}
